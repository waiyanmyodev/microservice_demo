# Development Dockerfile for User Service
FROM node:18-alpine

WORKDIR /app

# Install dependencies for development and native compilation
RUN apk add --no-cache git python3 make g++ openssl openssl-dev

# Copy package files
COPY package*.json ./
COPY shared/package*.json ./shared/
COPY services/user-service/package*.json ./services/user-service/

# Install root dependencies first
RUN npm ci && npm cache clean --force

# Install NestJS CLI globally  
RUN npm install -g @nestjs/cli

# Copy source code
COPY . .

# Build shared library
RUN npm run build:shared

# Set working directory to the service and install service-specific dependencies
WORKDIR /app/services/user-service
RUN npm ci --include=dev

# Rebuild native modules like bcrypt for the container architecture
RUN npm rebuild bcrypt --build-from-source

# Generate Prisma client
RUN npx prisma generate

# Expose port
EXPOSE 3002

# Start in development mode with hot reloading
CMD ["npm", "run", "start:dev"]