# Development Dockerfile for User Service
FROM node:18-alpine

WORKDIR /app

# Install dependencies for development
RUN apk add --no-cache git

# Copy package files
COPY package*.json ./
COPY shared/package*.json ./shared/
COPY services/user-service/package*.json ./services/user-service/

# Install ALL dependencies (including dev dependencies) and NestJS CLI globally
RUN npm ci && npm cache clean --force && npm install -g @nestjs/cli

# Copy source code
COPY . .

# Build shared library
RUN npm run build:shared

# Generate Prisma client
RUN cd services/user-service && npx prisma generate

# Set working directory to the service
WORKDIR /app/services/user-service

# Expose port
EXPOSE 3002

# Start in development mode with hot reloading
CMD ["npm", "run", "start:dev"]